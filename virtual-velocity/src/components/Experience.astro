---
---

<section id="experience">
  <!-- Section heading -->
  <div class="mb-10" data-reveal>
    <p class="text-subtext text-sm mb-1">
      <span class="text-blue">$</span> cat experience.md
    </p>
    <h2 class="text-text text-2xl font-bold">experience</h2>
    <div class="mt-2 h-px w-16 bg-blue opacity-50"></div>
  </div>

  <!-- Experience card -->
  <div
    class="bg-surface0 border border-surface1 rounded-lg p-6 md:p-8"
    data-reveal
    data-reveal-delay="1"
  >
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 md:gap-8">
      <!-- Left: role + company -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <span class="text-green text-sm">▸</span>
          <h3 class="font-bold text-base md:text-lg" style="color: #eff1f5">
            Backend AI Engineer
          </h3>
        </div>
        <p class="text-subtext text-sm ml-5">FlyRank AI · Remote (Chicago, IL)</p>
        <p class="text-subtext text-xs ml-5 opacity-70">Jul 2026 – Present</p>
      </div>

      <!-- Right: status badge -->
      <div class="ml-5 md:ml-0 shrink-0">
        <span class="text-green text-xs border border-green px-2 py-1 rounded opacity-70">
          ongoing
        </span>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-6 mb-5 h-px bg-surface1"></div>

    <!-- Description -->
    <p class="text-subtext text-sm leading-relaxed">
      Developing backend services with Express, SQLite, Supabase, and Docker, alongside ongoing
      AI-fluency training in agent design and workflow evaluation. Focused on writing clean,
      well-tested code and building strong fundamentals across the stack.
    </p>
  </div>
</section>
